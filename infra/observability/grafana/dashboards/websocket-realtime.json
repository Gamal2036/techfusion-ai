{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "WebSocket Connections by Namespace",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "websocket_connections", "legendFormat": "{{namespace}}" }
      ]
    },
    {
      "title": "WebSocket Disconnections",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rate(websocket_disconnections_total[5m])", "legendFormat": "{{namespace}} ({{reason}})" }
      ]
    },
    {
      "title": "WebSocket Auth Failures",
      "type": "stat",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "targets": [
        { "expr": "rate(websocket_auth_failures_total[5m])", "legendFormat": "{{namespace}}" }
      ]
    },
    {
      "title": "Remote Support Active Sessions",
      "type": "gauge",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
      "targets": [
        { "expr": "remote_support_active_sessions", "legendFormat": "{{service}}" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["techfusion", "websocket", "realtime"],
  "title": "WebSocket and Realtime",
  "uid": "tf-websocket-realtime"
}
