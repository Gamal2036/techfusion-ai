{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "HTTP Request Duration (P50/P95/P99)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "Requests by Status Code",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "sum by (status_code) (rate(http_requests_total[5m]))",
          "legendFormat": "{{status_code}}"
        }
      ]
    },
    {
      "title": "Auth Failures",
      "type": "stat",
      "gridPos": { "h": 10, "w": 6, "x": 12, "y": 10 },
      "targets": [
        {
          "expr": "rate(authentication_failures_total[5m])",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "title": "Rate Limit Rejections",
      "type": "stat",
      "gridPos": { "h": 10, "w": 6, "x": 18, "y": 10 },
      "targets": [
        {
          "expr": "rate(rate_limit_rejections_total[5m])",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["techfusion", "api"],
  "title": "API Gateway",
  "uid": "tf-api-gateway"
}
