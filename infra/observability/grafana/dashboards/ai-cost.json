{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "AI Provider Costs (USD/hr)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(ai_provider_cost_usd_total[5m]) * 3600", "legendFormat": "{{provider}}/{{model}}" }
      ]
    },
    {
      "title": "AI Provider Latency (P95)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(ai_provider_latency_ms_bucket[5m]))", "legendFormat": "{{provider}}/{{model}}" }
      ]
    },
    {
      "title": "AI Tokens Used",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "targets": [
        { "expr": "rate(ai_tokens_total[5m])", "legendFormat": "{{provider}}/{{model}} ({{type}})" }
      ]
    },
    {
      "title": "AI Request Status",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
      "targets": [
        { "expr": "rate(ai_requests_total[5m])", "legendFormat": "{{provider}}/{{model}} ({{status}})" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["techfusion", "ai", "cost"],
  "title": "AI Cost and Performance",
  "uid": "tf-ai-cost"
}
