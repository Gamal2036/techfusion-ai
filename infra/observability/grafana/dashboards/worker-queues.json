{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "Queue Depth per Queue",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "bullmq_queue_depth",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "title": "Job Completion Rate",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(bullmq_jobs_completed_total[5m])",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "title": "Job Failure Rate",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "rate(bullmq_jobs_failed_total[5m])",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "title": "Job Duration (P95)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(bullmq_job_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 {{queue}}/{{job_name}}"
        }
      ]
    },
    {
      "title": "Waiting / Active / Delayed Jobs",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "bullmq_waiting_jobs", "legendFormat": "waiting {{queue}}" },
        { "expr": "bullmq_active_jobs", "legendFormat": "active {{queue}}" },
        { "expr": "bullmq_delayed_jobs", "legendFormat": "delayed {{queue}}" }
      ]
    },
    {
      "title": "Oldest Waiting Job Age",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "bullmq_oldest_waiting_job_age_seconds",
          "legendFormat": "{{queue}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["techfusion", "worker", "queues"],
  "title": "Worker and Queues",
  "uid": "tf-worker-queues"
}
