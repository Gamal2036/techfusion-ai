# ═══════════════════════════════════════════════════════════════
# TechFusion AI — API Gateway Environment Configuration
# ═══════════════════════════════════════════════════════════════
# COPY this file to .env and fill in your values.
# ALL secrets below MUST be changed in production.
# Generate secrets with: openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════

# ── Node Environment ─────────────────────────────────────────
# Set to "production" in deployed environments
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=""

# ── Redis (for BullMQ job queues) ────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Authentication (REQUIRED) ────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# ── Support admin (optional; recovery endpoints) ─────────────
# JSON array of SHA-256 hex hashes of internal support-admin recovery keys.
# The key is sent in the `x-support-admin-key` header and compared as a hash
# (never stored or logged in plaintext). Absent/invalid → recovery endpoints 401.
# Generate each hash with: printf '%s' '<key>' | sha256sum
SUPPORT_ADMIN_API_KEY_HASHES="[]"

# ── Server ───────────────────────────────────────────────────
PORT=3001

# ── Encryption (REQUIRED) ────────────────────────────────────
# Generate with: openssl rand -hex 32
AI_ENCRYPTION_KEY=""

# ── Report signing (REQUIRED) ────────────────────────────────
# Generate with: openssl rand -hex 32
REPORT_URL_SECRET=""

# ── AI Provider API Keys (fill in the ones you use) ─────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
AI_ROUTER_STRATEGY="smart"
AI_FALLBACK_ENABLED="true"
AI_ROUTER_TIMEOUT_MS="30000"
AI_CIRCUIT_BREAKER_THRESHOLD="3"
AI_CIRCUIT_BREAKER_RESET_MS="600000"

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# In production, set to your frontend URL(s)
ALLOWED_ORIGINS="http://localhost:3000"
WS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# ── Web application (human-facing links) ─────────────────────
# Base URL of the Next.js web app. Invitation links (development invite
# links and future email links) resolve to this URL, e.g. WEB_APP_URL/invite/<token>.
# REQUIRED in production. Safe development default: http://localhost:3000
# WEB_APP_URL="http://localhost:3000"

# ── OpenTelemetry (optional) ────────────────────────────────
# OTEL_ENABLED="true"
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
# OTEL_SERVICE_NAME="techfusion-api"
# OTEL_SAMPLE_RATE="0.1"

# ── Metrics Endpoint Security (optional) ─────────────────────
# METRICS_AUTH_TOKEN=""

# ── Observability (optional) ─────────────────────────────────
# NEXT_PUBLIC_OBSERVABILITY_ENABLED="false"
# NEXT_PUBLIC_OBSERVABILITY_ENDPOINT=""
# NEXT_PUBLIC_OBSERVABILITY_SAMPLE_RATE="0.1"

# ── Transactional Email (foundation) ──────────────────────────
# Set MAIL_ENABLED=true to enable transactional email sending.
# When disabled (default), the system starts without mail credentials.
MAIL_ENABLED="false"
# MAIL_TRANSPORT="smtp" (default) or "test"
MAIL_FROM_ADDRESS="noreply@techfusion.ai"
MAIL_FROM_NAME="TechFusion AI"
# MAIL_REPLY_TO="support@techfusion.ai"

# ── SMTP Configuration (required when MAIL_ENABLED=true) ──────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_CONNECTION_TIMEOUT_MS="10000"
SMTP_GREETING_TIMEOUT_MS="10000"
SMTP_SOCKET_TIMEOUT_MS="30000"
